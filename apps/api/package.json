{
  "name": "@cf/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "node build.mjs",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/scripts/migrate.ts",
    "admin:create": "tsx --env-file-if-exists=.env src/scripts/create-admin.ts",
    "client:create": "tsx --env-file-if-exists=.env src/scripts/create-client-user.ts",
    "leads:seed": "tsx --env-file-if-exists=.env src/scripts/seed-us-leads.ts"
  },
  "dependencies": {
    "@cf/shared": "*",
    "@vercel/blob": "^2.8.2",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.0",
    "express": "^5.2.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.0",
    "pg": "^8.23.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.0",
    "drizzle-kit": "^0.31.0",
    "esbuild": "^0.28.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.0",
    "typescript": "~6.0.0",
    "vitest": "^5.0.0"
  }
}
