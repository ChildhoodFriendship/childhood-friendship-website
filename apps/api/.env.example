# Copia in .env (mai committare .env)
NODE_ENV=development
PORT=3000
# Postgres (Neon: usa la connection string "pooled"). In locale puoi usare: pglite:./.data/dev
DATABASE_URL=pglite:./.data/dev
# Origine pubblica del frontend (link inviti, CORS/CSRF)
APP_URL=http://localhost:4200
# Segreto firma JWT: minimo 32 caratteri casuali  ->  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Chiave AES-256 per credenziali clienti: 32 byte in base64  ->  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_KEY=
# AI (opzionale). Provider: gemini | openai-compatible
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash
# Per provider openai-compatible (Groq, OpenRouter)
AI_BASE_URL=
AI_API_KEY=
AI_DAILY_LIMIT=50
